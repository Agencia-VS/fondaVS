# Copy to .env.local; configure the same values in Vercel.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Alias aceptado si tu proyecto todavía muestra la clave anon antigua.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never prefix this with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
# Alias aceptado para proyectos que todavía muestran service_role.
SUPABASE_SERVICE_ROLE_KEY=
# Comma-separated emails of existing confirmed Supabase Auth users.
OPERATOR_EMAILS=
